{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["uvx", "mcp-nixos"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push *force*": "ask",
      "git push -f*": "ask",
      "git push --force*": "ask"
    }
  }
}