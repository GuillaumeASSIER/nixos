{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["uvx", "mcp-nixos"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git push *force*": "ask",
      "git push -f*": "ask",
      "git push --force*": "ask",
      "cat .envrc": "deny"
    },
    "read": {
      ".envrc": "deny",
      ".vault_pass": "deny"
    },
    "edit": {
      ".envrc": "deny",
      ".vault_pass": "deny"
    }
  }
}